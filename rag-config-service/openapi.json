  "components": {
    "schemas": {
      "ChunkingConfig": {
        "type": "object",
        "properties": {
          "method": {
            "type": "string",
            "nullable": true
          },
          "chunkSize": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "chunkOverlap": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "params": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/components/schemas/JsonNode"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "DatabaseConnectionRequest": {
        "type": "object",
        "properties": {
          "dialect": {
            "type": "string",
            "nullable": true
          },
          "host": {
            "type": "string",
            "nullable": true
          },
          "port": {
            "type": "integer",
            "format": "int32"
          },
          "dbname": {
            "type": "string",
            "nullable": true
          },
          "user": {
            "type": "string",
            "nullable": true
          },
          "schema": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "JsonNode": {
        "type": "object",
        "properties": {
          "options": {
            "$ref": "#/components/schemas/JsonNodeOptions"
          },
          "parent": {
            "$ref": "#/components/schemas/JsonNode"
          },
          "root": {
            "$ref": "#/components/schemas/JsonNode"
          }
        },
        "additionalProperties": false
      },
      "JsonNodeOptions": {
        "type": "object",
        "properties": {
          "propertyNameCaseInsensitive": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "KnowledgeBaseRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "nullable": true
          },
          "strategyId": {
            "type": "string",
            "nullable": true
          },
          "groupIds": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "nullable": true
          },
          "collectionName": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "StrategyRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "nullable": true
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "chunking": {
            "$ref": "#/components/schemas/ChunkingConfig"
          },
          "topK": {
            "type": "integer",
            "format": "int32"
          },
          "topPOptionId": {
            "type": "string",
            "nullable": true
          },
          "embeddingModelSource": {
            "type": "string",
            "nullable": true
          },
          "embeddingModelRef": {
            "type": "string",
            "nullable": true
          },
          "retrieval": {
            "type": "string",
            "nullable": true
          },
          "reranking": {
            "type": "string",
            "nullable": true
          },
          "language": {
            "type": "string",
            "nullable": true
          },
          "groupIds": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "nullable": true
          },
          "imageModelRef": {
            "type": "string",
            "nullable": true
          },
          "vectorDbMode": {
            "type": "string",
            "nullable": true
          },
          "vectorDbTypeId": {
            "type": "string",
            "nullable": true
          },
          "vectorDbConfig": {
            "$ref": "#/components/schemas/VectorDbConfigDto"
